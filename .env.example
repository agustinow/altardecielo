# Required: secret used by Payload to sign tokens (generate a long random string)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of the site (used for SEO metadata and Payload)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database. If DATABASE_URL (Postgres) is set it takes priority (production/Neon).
# Otherwise a local SQLite file is used — zero setup for development.
# DATABASE_URL=postgres://user:pass@host:5432/altar_de_cielo
SQLITE_URL=file:./altar-de-cielo.db

# Contact form email delivery (optional in dev — submissions are always stored in the admin panel)
# RESEND_API_KEY=re_...
# CONTACT_EMAIL_TO=ara@example.com
# CONTACT_EMAIL_FROM=web@yourdomain.com
